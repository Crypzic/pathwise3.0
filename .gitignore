# Dependencies
node_modules/

# Build output
dist/
dist-test/
build/

# Prisma generated client — always regenerated by `prisma generate`,
# never committed (a stale committed copy can shadow a fresh generate).
backend/node_modules/.prisma/
backend/generated/

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Local SQLite dev DB
backend/prisma/*.db
backend/prisma/*.db-journal
backend/*.db

# Logs
*.log
npm-debug.log*

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Frontend build
frontend/dist/
