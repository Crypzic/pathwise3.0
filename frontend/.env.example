# Leave empty for local dev — Vite's proxy (vite.config.ts) forwards /api/*
# to your local backend automatically.
#
# Set this to your deployed backend's URL once you deploy the frontend
# (e.g. to Vercel) — there's no dev proxy on a static, deployed site.
# Example: VITE_API_URL="https://pathwise-api.onrender.com"
VITE_API_URL=
