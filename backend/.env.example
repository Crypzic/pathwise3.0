# --- Pathwise backend environment ---
# Copy this file to `.env` and fill in real values for anything you want to enable.

# SQLite database file (relative to the backend/ folder)
DATABASE_URL="file:./dev.db"

# Secret used to sign login tokens. Change this to a long random string in production.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# Where the frontend runs (used for CORS). Vite defaults to 5173.
CORS_ORIGIN="http://localhost:5173"
# When you deploy the frontend to Vercel, change this to your Vercel URL
# (e.g. "https://pathwise.vercel.app") or the backend will reject requests
# from it. Multiple origins aren't supported by this simple setup yet —
# revisit if you need both local + production working simultaneously.

# Port the backend listens on
PORT=4000

# --- AI provider ---
# AI_PROVIDER can be "mock" (free, no key needed — great for development),
# "openai", or "gemini" (the PATHWISE 2.0 testing-phase primary). Application
# logic never depends on which one is active.
AI_PROVIDER="mock"

# Only needed when AI_PROVIDER="openai". Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Only needed when AI_PROVIDER="gemini". Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
# Tried once if the primary model call fails (timeout/5xx/bad response)
# before giving up. Leave blank to disable the fallback retry.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# Above this, a PDF is parsed to text locally only (no native document
# vision) — Gemini's inline request body caps out around 20MB.
MAX_INLINE_PDF_MB=15

# Image uploads (photos of notes/whiteboards/slides) travel base64-encoded to
# the vision provider in one request — capped tighter than documents.
MAX_IMAGE_MB=8

# Free-tier limit: how many courses a non-premium user can create.
FREE_COURSE_CAP=3

# --- Email (forgot-password flow) ---
# EMAIL_PROVIDER can be "mock" (free, default — prints the reset link to the
# console instead of sending real email) or "resend".
EMAIL_PROVIDER="mock"

# Only needed when EMAIL_PROVIDER="resend". Free tier: 3,000 emails/month.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Pathwise <onboarding@resend.dev>"

# Used to build the link inside password-reset emails.
APP_URL="http://localhost:5173"

# --- Production database (optional) ---
# Leave both empty for local dev — DATABASE_URL above (a local file) is used.
# In production (e.g. Render), set these instead: Turso is hosted SQLite with
# a free tier, and unlike a local file, it survives restarts/redeploys.
# Get both from https://turso.tech after creating a database.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- AI cost metering (Step 1 item 6) ---
# Every AI call is logged to the AIUsage table with tokens and estimated cost.
# These are USD per 1M tokens for the configured model — defaults match
# gpt-4o-mini list pricing. Update them to match whichever model you set
# (OPENAI_MODEL or GEMINI_MODEL) — check the provider's current price list.
AI_PRICE_INPUT_PER_MTOK=0.15
AI_PRICE_OUTPUT_PER_MTOK=0.6

# Hard per-user daily ceiling on AI spend, in US cents. Requests past this are
# refused with a 429 rather than quietly running up a bill. Set 0 to disable.
# Ignored when AI_PROVIDER="mock", which is free.
AI_DAILY_USER_BUDGET_CENTS=50

# --- Quiz tuning ---
QUIZ_DEFAULT_LENGTH=8
QUIZ_MAX_LENGTH=20

# --- Billing (Step 13) ---
# "mock" runs the whole upgrade/cancel flow with no Stripe account, so the
# monetization path is testable before payments go live. "stripe" is real.
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs from your Stripe dashboard (recurring monthly / yearly products).
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# --- Content moderation (Step 15) ---
# Screens uploaded material before it becomes a knowledge map. Leave on.
MODERATION_ENABLED=true

# --- Feature flags (PATHWISE 2.0) ---
# Enforced server-side; the frontend reads them from GET /api/config.
# Leaf Match (mini-game + Garden XP shop) is frozen per Phase 0 — the code
# stays for a clean replacement by Wise Path later. Set true to un-freeze.
FEATURE_LEAF_MATCH=false
# Guest mode (Phase 1): "Continue as guest" on the sign-in screen.
FEATURE_GUEST_MODE=true
# Hidden creator infrastructure (Phase 16). The whole user-video pipeline is
# built but DARK: leave this false until moderation is proven with real
# usage. Internal testing works regardless via the x-cron-secret header.
FEATURE_USER_VIDEO_POSTING=false

# --- Guest limits (PATHWISE 2.0 Phase 1) ---
# All enforced server-side. Guests sample the core loop; everything expires
# GUEST_TTL_DAYS after the session starts (the cron sweep deletes rows AND
# stored files). Claiming an account keeps all progress.
GUEST_TTL_DAYS=7
GUEST_COURSE_CAP=1
GUEST_UPLOAD_CAP=3
GUEST_MAX_FILE_MB=10
GUEST_AI_DAILY_BUDGET_CENTS=10
GUEST_SOCRATIC_MAX_TURNS=15
GUEST_QUIZ_SESSIONS_PER_DAY=5

# Terms of Service version. Bump this to re-prompt every user for acceptance.
TOS_VERSION="2026-07-01"

# --- Scheduled jobs (Step 12) ---
# Shared secret for POST /api/cron/sweep (notifications + expired-account purge)
# and GET /api/ops/metrics (AI spend + activation funnel). Both are refused when
# this is empty, so set it to a long random string before relying on either.
# Point an external scheduler at the sweep endpoint every 15-30 minutes:
#   curl -X POST -H "x-cron-secret: $CRON_SECRET" https://your-api/api/cron/sweep
CRON_SECRET=""

# --- Security (beta prep) ---
# Login-token lifetime in days. Any 401 signs the client out.
JWT_TTL_DAYS=30

# --- File storage (beta prep) ---
# "local" writes to backend/uploads — fine for dev, EPHEMERAL on Render (files
# vanish on redeploy). "s3" works with Cloudflare R2 (free tier), AWS S3, or
# Backblaze B2. See DEPLOYMENT.md for the R2 walkthrough.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Hard per-session ceiling on Socratic turns (each turn is a paid AI call —
# two, when the leak guard retries). See docs/product/cost-model.md.
SOCRATIC_MAX_TURNS=60
