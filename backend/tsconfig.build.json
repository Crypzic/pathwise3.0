// Production build: same settings as dev, minus tests, plus two pragmatic
// relaxations so a cloud build never blocks on unannotated params (TS7006)
// or third-party type quirks. Local typecheck (tsconfig.json, strict) stays
// the honest gate.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
